rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name','studentId','answers','score','percentage','submittedAt','uid'])
        && request.resource.data.answers.size() == 10
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10
        && request.resource.data.percentage == request.resource.data.score * 10;
      allow read: if false;
      allow update, delete: if false;
    }
  }
}